APP_NAME="Infinity URL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17 — voir compose.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infinity_url
DB_USERNAME=infinity_url
DB_PASSWORD=secret

# Aucune session sur l'API : le dashboard utilise des jetons Sanctum.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Valkey — Horizon et le cache partagent la même instance.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit en local (interface sur http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@infinityproject.fr"
MAIL_FROM_NAME="Infinity Project"

# --- Secrets applicatifs -----------------------------------------------------

# Clé de l'index aveugle des emails (HMAC-SHA256). Distincte d'APP_KEY :
# la rotation d'APP_KEY ne doit pas invalider l'unicité des emails.
# Ne tourne JAMAIS. Générer : openssl rand -base64 32
BLIND_INDEX_KEY=

# Secret partagé avec Traefik pour /internal/tls/ask (v0.2).
TRAEFIK_INTERNAL_TOKEN=

# Fichier contenant le sel analytique, hors base et hors sauvegarde.
ANALYTICS_SALT_PATH=/secrets/analytics.salt

# Tri assisté par modèle (v0.2). Désactivé par défaut : le produit fonctionne
# exactement de la même façon sans lui.
AI_TRIAGE_ENABLED=false

# --- Divers ------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
