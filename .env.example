APP_NAME="Infinity URL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# The link domain. On localhost, exercise the redirect path with
# `curl -H 'Host: iurl.fr' http://localhost:8000/{slug}`.
LINK_HOST=iurl.fr

# Optional public base for the short URL, including scheme and port. Set it
# for local development (`http://iurl.test:8001`) and leave it empty in
# production, where the canonical `https://iurl.fr` is used.
LINK_URL=

# Dashboard origin, used in email links and in CORS.
DASHBOARD_URL=https://url.infinityproject.fr

# Days of aggregated analytics kept on the hosted instance.
STATS_RETENTION_DAYS=30

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17 — see compose.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infinity_url
DB_USERNAME=infinity_url
DB_PASSWORD=secret

# No session on the API: the dashboard uses Sanctum tokens.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Valkey — Horizon and the cache share one instance.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit locally (web UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@infinityproject.fr"
MAIL_FROM_NAME="Infinity Project"

# --- Application secrets -----------------------------------------------------

# HMAC key for the email blind index. Must differ from APP_KEY so that
# rotating APP_KEY does not invalidate email uniqueness.
# Never rotates. Generate with: openssl rand -base64 32
BLIND_INDEX_KEY=

# Shared secret for /internal/tls/ask (v0.2).
TRAEFIK_INTERNAL_TOKEN=

# File holding the analytics salt, outside the database and outside backups.
ANALYTICS_SALT_PATH=/secrets/analytics.salt

# Model-assisted triage (v0.2). Off by default: the product behaves the same
# without it.
AI_TRIAGE_ENABLED=false

# --- Abuse -------------------------------------------------------------------

# The destination inspection runs once, at link creation. Keep it enabled in
# production; disable it only for a deterministic end-to-end run.
ABUSE_CHECK_ENABLED=true

# Public suffix list. Vendored in resources/psl for an offline, deterministic
# run; override only to test a different copy.
PSL_PATH=

# Local dumps, downloaded once a day. No client URL is ever sent to them.
URLHAUS_URL=https://urlhaus.abuse.ch/downloads/text/
URLHAUS_AUTH_KEY=
PHISHING_ARMY_URL=https://phishing.army/download/phishing_army_blocklist_extended.txt
OPENPHISH_URL=https://openphish.com/feed.txt

# Domain age. Only the registrable domain is sent, and the answer is cached.
RDAP_URL=https://rdap.org/domain/

# Self-hosted ntfy topic. Empty disables the alert, never the work.
NTFY_URL=

# The kill switch: false closes registrations without a deployment. Closed by
# default in production; keep it true locally.
SIGNUPS_OPEN=true
