APP_NAME="Infinity URL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# The link domain. On localhost, exercise the redirect path with
# `curl -H 'Host: iurl.fr' http://localhost:8000/{slug}`.
LINK_HOST=iurl.fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17 — see compose.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infinity_url
DB_USERNAME=infinity_url
DB_PASSWORD=secret

# No session on the API: the dashboard uses Sanctum tokens.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Valkey — Horizon and the cache share one instance.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit locally (web UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@infinityproject.fr"
MAIL_FROM_NAME="Infinity Project"

# --- Application secrets -----------------------------------------------------

# HMAC key for the email blind index. Must differ from APP_KEY so that
# rotating APP_KEY does not invalidate email uniqueness.
# Never rotates. Generate with: openssl rand -base64 32
BLIND_INDEX_KEY=

# Shared secret for /internal/tls/ask (v0.2).
TRAEFIK_INTERNAL_TOKEN=

# File holding the analytics salt, outside the database and outside backups.
ANALYTICS_SALT_PATH=/secrets/analytics.salt

# Model-assisted triage (v0.2). Off by default: the product behaves the same
# without it.
AI_TRIAGE_ENABLED=false
