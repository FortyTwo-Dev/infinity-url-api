includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - routes/
        - database/
    # Les règles métier vivent dans app/Actions et app/Services : on veut le
    # niveau 6 partout, pas seulement sur les contrôleurs.
    treatPhpDocTypesAsCertain: false
